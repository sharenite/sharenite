{
  "name": "app",
  "private": "true",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@hotwired/stimulus": "^3.1.0",
    "@hotwired/turbo-rails": "^8.0.0",
    "@popperjs/core": "^2.11.6",
    "bootstrap": "^5.2.0",
    "bootstrap-icons": "^1.9.1",
    "choices.js": "^11.1.0",
    "esbuild": "^0.28.2",
    "sass": "^1.105.1"
  },
  "scripts": {
    "precommit": "lint-staged --hide-unstaged",
    "prettier": "./node_modules/.bin/prettier --plugin=@prettier/plugin-ruby --write 'app/**/*.{js,es6,jsx,scss,css,haml}'",
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --outdir=app/assets/builds --public-path=assets",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules"
  },
  "lint-staged": {
    "app/**/*.{js,es6,jsx,scss,css,haml}": [
      "./node_modules/.bin/prettier --plugin=@prettier/plugin-ruby --write"
    ],
    "{app,test}/**/*.rb": [
      "bundle exec rubocop -a"
    ]
  },
  "devDependencies": {
    "@prettier/plugin-ruby": "^4.0.2",
    "husky": "^9",
    "lint-staged": "^17.6.0",
    "prettier": "^3"
  }
}
